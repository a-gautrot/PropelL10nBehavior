{
  "name": "agautrot/propel-l10n-behavior",
  "description": "Integration of localization (l10n) in Propel",
  "type": "propel-behavior",
  "license": "MIT",
  "keywords": [
    "propel",
    "behavior",
    "l10n"
  ],
  "authors": [
    {
      "name": "Thomas Gossmann",
      "role": "Author"
    },
    {
      "name": "Sébastien Coueille",
      "role": "Maintenance"
    },
    {
      "name": "Alexandre Gautrot",
      "email": "alexandre.gautrot@etik.com",
      "role": "Maintenance"
    }
  ],
  "autoload": {
    "psr-4": {
      "Gossi\\Propel\\Behavior\\L10n\\": "src"
    }
  },
  "require": {
    "ext-intl": "*",
    "mikey179/vfsstream": "^1.6",
    "php": "^7.4||>=8.0",
    "propel/propel": "~2.0.0-beta4||^2.0"
  },
  "require-dev": {
    "ext-pdo_sqlite": "*",
    "phpstan/phpstan": "@stable",
    "phpunit/phpunit": ">=9.6.33",
    "squizlabs/php_codesniffer": "@stable",
    "vimeo/psalm": "@stable"
  },
  "extra": {
    "name": "l10n",
    "class": "\\Gossi\\Propel\\Behavior\\L10n\\L10nBehavior"
  },
  "scripts": {
    "test": "@php tests/run.php",
    "test:coverage": "@test --coverage-clover tests/coverage.xml --log-junit tests/junit.xml",
    "phpstan": "vendor/bin/phpstan analyse -c phpstan.dist.neon",
    "psalm": "vendor/bin/psalm --config=psalm.dist.xml",
    "phpcs": "phpcs --standard=PSR2 src"
  }
}
